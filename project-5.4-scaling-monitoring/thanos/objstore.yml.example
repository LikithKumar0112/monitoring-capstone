# Example only — the real objstore.yml is generated at runtime by the
# `minio-init` service from ${MINIO_ROOT_USER}/${MINIO_ROOT_PASSWORD} into the
# shared `thanos_config` volume, so no credentials are ever committed to Git.
# This file documents the shape Thanos expects; it is NOT read by the stack.
type: S3
config:
  bucket: thanos
  endpoint: minio:9000
  access_key: ${MINIO_ROOT_USER}
  secret_key: ${MINIO_ROOT_PASSWORD}
  insecure: true   # MinIO runs plain HTTP on the internal Docker network
