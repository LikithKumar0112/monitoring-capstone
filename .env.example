# =============================================================================
# Shared environment for the Monitoring Capstone (Section 5)
# Copy this file to `.env` in each project folder you run, and edit as needed:
#     cp .env.example .env
# `.env` is git-ignored so your secrets never get committed.
# =============================================================================

# ---- Grafana (5.1 and 5.4) --------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_admin

# ---- Elasticsearch (5.2) ----------------------------------------------------
# Heap size per JVM. Keep to ~50% of the RAM you give the ES container.
ES_JAVA_OPTS=-Xms1g -Xmx1g
# Password for the built-in `elastic` superuser (only used when xpack security
# is enabled — the "Beyond the Basics" stretch goal in 5.2).
ELASTIC_PASSWORD=change_me_elastic
KIBANA_PASSWORD=change_me_kibana

# ---- Alertmanager (5.3) -----------------------------------------------------
# Create an "Incoming Webhook" in Slack and paste the URL here.
# Leave blank to use the no-op console receiver instead.
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#alerts

# ---- MinIO object storage (5.4) ---------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio

# ---- HA Grafana shared DB (5.4 stretch) -------------------------------------
GF_DB_USER=grafana
GF_DB_PASSWORD=change_me_gfdb
GF_DB_NAME=grafana
