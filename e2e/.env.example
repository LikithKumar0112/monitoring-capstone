# e2e — copy to .env and fill in. .env is git-ignored (see .gitignore).
#   cp .env.example .env
# Never commit the real .env.

# Grafana admin login.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_admin

# MinIO root credentials (also become the Thanos S3 access/secret key at runtime).
# MINIO_ROOT_PASSWORD must be at least 8 characters.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio

# Slack Incoming Webhook for Alertmanager. Leave blank to disable delivery.
SLACK_WEBHOOK_URL=

# Elasticsearch built-in superuser password. Only used when xpack.security is
# enabled (off by default in this demo), but referenced by compose so the wiring
# exists for the stretch goal.
ELASTIC_PASSWORD=change_me_elastic

# JVM heap for Elasticsearch (kept ~50% of its mem_limit). Override if you resize.
ES_JAVA_OPTS=-Xms512m -Xmx512m
